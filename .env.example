# Optional: required only for cross-device development on a local network.
# Replace YOUR_LAN_IP with the computer's active private IPv4 address.
NEXT_ALLOWED_DEV_ORIGINS=YOUR_LAN_IP
NEXT_PUBLIC_APP_ORIGIN=http://YOUR_LAN_IP:3000

# Optional MapTiler satellite tiles. Empty keeps the ordinary map available.
# Public browser key: restrict allowed origins in MapTiler, then restart dev/rebuild.
NEXT_PUBLIC_MAPTILER_KEY=
