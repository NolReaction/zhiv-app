{
    servers {
        max_header_size 32KB
        timeouts {
            read_header 10s
            read_body 15s
            write 30s
            idle 2m
        }
    }
}

{$DOMAIN:localhost} {
    request_body {
        max_size 16KB
    }
    encode zstd gzip

    @admin path /admin /admin/* /api/v1/admin/*
    header @admin >Cache-Control "no-store"
    header @admin >X-Robots-Tag "noindex, nofollow"

    # Explicit order: lifecycle status remains reachable while every write is gated.
    route {
        handle /app-status.json {
            header Cache-Control "no-store"
            @deployedStatus file {
                root /srv/deploy
                try_files /app-status.json
            }
            handle @deployedStatus {
                root * /srv/deploy
                file_server
            }
            # Fresh installations have no deployment state until their first update.
            handle {
                reverse_proxy web:3000
            }
        }
        @internal path /internal /internal/* /metrics
        respond @internal 404
        @maintenance file {
            root /srv/deploy
            try_files /maintenance
        }
        handle @maintenance {
            header Cache-Control "no-store"
            header Retry-After "15"
            respond "Приложение обновляется. Пожалуйста, подождите немного и обновите страницу." 503
        }
        @api path /api/* /healthz /readyz
        handle @api {
            reverse_proxy api:8080
        }
        handle {
            reverse_proxy web:3000
        }
    }

    header {
        -Server
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
    }
}
