
DOMAIN=zhiv.example.ru
# Three separate random passwords in a private 700 directory (files 444 for container readers). Never commit them.
# Run: node scripts/create-deploy-secrets.mjs
# Existing database: db_admin must contain its EXISTING password.
DB_ADMIN_PASSWORD_FILE=./.secrets/db_admin
DB_MIGRATION_PASSWORD_FILE=./.secrets/db_migration
DB_APP_PASSWORD_FILE=./.secrets/db_app
