
DOMAIN=zhiv.example.ru
# Admin accounts use the existing app login. Empty means no administrator access.
# Configure with: python3 scripts/configure-admin.py --public-id XXXX-XXXX-XXXX
ADMIN_PUBLIC_IDS=
MONITORING_URL=
METRICS_TOKEN_FILE=
COMPOSE_PROFILES=
# Three separate random passwords in a private 700 directory (files 444 for container readers). Never commit them.
# Run: node scripts/create-deploy-secrets.mjs
# Existing database: db_admin must contain its EXISTING password.
DB_ADMIN_PASSWORD_FILE=./.secrets/db_admin
DB_MIGRATION_PASSWORD_FILE=./.secrets/db_migration
DB_APP_PASSWORD_FILE=./.secrets/db_app

# Login providers. Keep disabled until their application/resource is configured.
# Auth files below are paths INSIDE the API container; host directory deploy/.secrets/auth/.
VK_CLIENT_ID=
# Legacy Telegram credentials can remain empty. VK ID uses Authorization Code + PKCE.
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET_FILE=
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS_MODE=starttls
SMTP_USER=
SMTP_PASSWORD_FILE=
SMTP_FROM=
AUTH_CODE_SECRET_FILE=
# Selectel mail relay: SMTP_HOST=smtp.mail.selcloud.ru, SMTP_PORT=1126,
# SMTP_TLS_MODE=starttls, SMTP_FROM=login@your-domain.ru.
# Example enabled paths: /run/auth-secrets/telegram_client_secret,
# /run/auth-secrets/smtp_password, /run/auth-secrets/code_secret
